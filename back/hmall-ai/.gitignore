# ---------------------------------------------------------------------------
# Python 服务的忽略规则（只作用于 hmall-ai 目录，仓库根目录的 .gitignore 仍然生效）
# ---------------------------------------------------------------------------

# 字节码与缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
.venv/
venv/
ENV/
env/
.conda/

# 本地配置与密钥（.env.example 要保留）
.env
.env.*
!.env.example

# 测试与工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# 运行时产物
logs/
*.log
*.pid

# 本地向量库/模型缓存
.data/
.models/
model_cache/
