# ==========================================================================
# hmall-ai 环境变量样例（不含任何真实密钥，可直接提交）
# 用法：copy .env.example .env，然后在 .env 里填 key
# ==========================================================================

# ----------------------------- 服务 ---------------------------------------
APP_NAME=hmall-ai
ENV=dev
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_PREFIX=/ai
LOG_LEVEL=INFO
LOG_DIR=logs

# ----------------------------- CORS ---------------------------------------
# 前端是 Nginx 上的静态页（18080/18081/18082）；全部放开写 *
CORS_ORIGINS=http://localhost:18080,http://127.0.0.1:18080,http://localhost:18081,http://127.0.0.1:18081,http://localhost:18082,http://127.0.0.1:18082
CORS_ALLOW_CREDENTIALS=true

# ----------------------------- 大模型（统一配置）--------------------------
# 全项目只有这一套 key：Agent 和 RAG 问答都读 LLM_*。
# 默认 DeepSeek（兼容 OpenAI 协议）；换 OpenAI / 通义 / Kimi 只改 LLM_BASE_URL + LLM_MODEL。
# 申请：https://platform.deepseek.com/api_keys
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60

# ----------------------------- Embedding（硅基流动）-----------------------
# bge-m3：1024 维，中文语义检索效果好；商品语义检索和政策库共用
# 申请：https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ----------------------------- Milvus -------------------------------------
# 本机 Docker：docker start milvus-standalone
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=hmall_items
POLICY_COLLECTION=hmall_policy
POLICY_TOP_K=3
POLICY_FILE=policy.txt

# ----------------------------- 会话记忆 -----------------------------------
# sqlite：落盘，重启不丢；memory：进程内，测试用
MEMORY_BACKEND=sqlite
MEMORY_DB_PATH=data/memory.db

# ----------------------------- Nacos 注册 ---------------------------------
# 打开后网关可用 lb://hmall-ai 走服务发现
NACOS_ENABLED=false
NACOS_SERVER_ADDR=192.168.150.131:8848
NACOS_NAMESPACE=public
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_SERVICE_NAME=hmall-ai
NACOS_GROUP=DEFAULT_GROUP
NACOS_REGISTER_IP=
NACOS_REGISTER_PORT=0

# ----------------------------- Java 微服务 --------------------------------
HMALL_GATEWAY_URL=http://localhost:8080
HTTP_TIMEOUT=5
ORDER_LATEST_PATH=/api/order/latest